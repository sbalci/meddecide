"{pred} (Bootstrap): Apparent AUC = {app} (logistic model of the marker; "
"{level}% DeLong interval of the apparent AUC {lo} to {hi}), Optimism = {opt} "
"(SD across resamples {sd}), Corrected AUC = {corr}"
msgstr ""
"{pred} (Bootstrap): Görünen AUC = {app} (belirtecin lojistik modeli; görünen "
"AUC için %{level} DeLong aralığı {lo} ile {hi} arası), İyimserlik = {opt} "
"(yeniden örneklemler arasında SS {sd}), Düzeltilmiş AUC = {corr}"

#: R/enhancedROC.b.R
msgid ""
"{pred} (Bootstrap): Apparent AUC = {app} (logistic model of the marker; no "
"DeLong interval, its standard error is 0 or undefined), Optimism = {opt} (SD "
"across resamples {sd}), Corrected AUC = {corr}"
msgstr ""
"{pred} (Bootstrap): Görünür AUC = {app} (belirtecin lojistik modeli; DeLong "
"aralığı yok, standart hatası 0 veya tanımsız), İyimserlik = {opt} (yeniden "
"örneklemler arası SS {sd}), Düzeltilmiş AUC = {corr}"

