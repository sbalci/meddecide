#: agreement/ui[28].label
msgid "Stuart-Maxwell Test [Categorical] (Marginal Homogeneity, 2 Raters)"
msgstr "Stuart-Maxwell Testi [Kategorik] (Marjinal Homojenlik, 2 Değerlendirici)"

#: agreement/results/stuartMaxwellTable.title
