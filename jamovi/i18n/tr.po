msgid "<h4>Likelihood Ratios</h4>"
msgstr "<h4>Olabilirlik Oranları</h4>"

#: R/sequentialtests.b.R
msgid "<h4>Parallel Testing Strategy</h4>"
msgstr "<h4>Paralel Test Stratejisi</h4>"

#: R/sequentialtests.b.R
msgid "<h4>Predictive Values Calculations</h4>"
msgstr "<h4>Öngörü Değerleri Hesaplamaları</h4>"

#: R/sequentialtests.b.R
msgid "<h4>Probability Conversions</h4>"
msgstr "<h4>Olasılık Dönüşümleri</h4>"

#: R/sequentialtests.b.R
msgid "<h4>Serial Testing Strategy (Testing Negatives)</h4>"
msgstr "<h4>Seri Test Stratejisi (Negatifleri Test Etme)</h4>"

#: R/sequentialtests.b.R
msgid "<h4>Serial Testing Strategy (Testing Positives)</h4>"
msgstr "<h4>Seri Test Stratejisi (Pozitifleri Test Etme)</h4>"

#: R/sequentialtests.b.R
msgid "<h5>Combined Sensitivity</h5>"
msgstr "<h5>Birleşik Duyarlılık</h5>"

#: R/sequentialtests.b.R
msgid "<h5>Combined Specificity</h5>"
msgstr "<h5>Birleşik Özgüllük</h5>"

#: R/sequentialtests.b.R
msgid "<h5>Negative Likelihood Ratio (LR-)</h5>"
msgstr "<h5>Negatif Olabilirlik Oranı (LR-)</h5>"

#: R/sequentialtests.b.R
msgid "<h5>Negative Predictive Value (NPV)</h5>"
msgstr "<h5>Negatif Öngörü Değeri (NÖD)</h5>"

#: R/sequentialtests.b.R
msgid "<h5>Positive Likelihood Ratio (LR+)</h5>"
msgstr "<h5>Pozitif Olabilirlik Oranı (LR+)</h5>"

#: R/sequentialtests.b.R
msgid "<h5>Positive Predictive Value (PPV)</h5>"
msgstr "<h5>Pozitif Öngörü Değeri (PÖD)</h5>"

#: R/lassologistic.b.R
msgid ""
"<li><strong>1SE Rule</strong>: Selects the most parsimonious model within 1 "
"SE of minimum CV error.</li>"
msgstr ""
"<li><strong>1SE Kuralı</strong>: Minimum ÇD hatasının 1 SE içindeki en yalın "
"modeli seçer.</li>"

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Convert post-test odds back to probability</strong>: Post-test P "
"= Odds/(1+Odds)</li>"
msgstr ""
"<li><strong>Test sonrası odds'u tekrar olasılığa dönüştürün</strong>: Test "
"sonrası P = Odds/(1+Odds)</li>"

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Convert pre-test probability to odds</strong>: Odds = "
"P/(1-P)</li>"
msgstr ""
"<li><strong>Test öncesi olasılığı odds'a dönüştürün</strong>: Odds = "
"P/(1-P)</li>"

#: R/lassologistic.b.R
msgid ""
"<li><strong>Elastic Net</strong>: Combines L1 and L2 penalties; useful when "
"predictors are correlated.</li>"
msgstr ""
"<li><strong>Elastic Net</strong>: L1 ve L2 cezalarını birleştirir; tahmin "
"ediciler korelasyonlu olduğunda yararlıdır.</li>"

#: R/lassologistic.b.R
msgid ""
"<li><strong>Lambda</strong>: Controls regularization strength. Higher lambda "
"= fewer variables selected.</li>"
msgstr ""
"<li><strong>Lambda</strong>: Düzenlileştirme gücünü kontrol eder. Daha "
"yüksek lambda = daha az değişken seçilir.</li>"

#: R/lassologistic.b.R
msgid ""
"<li><strong>Lambda</strong>: Controls regularization strength. Higher lambda "
"shrinks every coefficient further toward zero, but none reaches zero, so the "
"number of variables never changes.</li>"
msgstr ""
"<li><strong>Lambda</strong>: Düzenlileştirme gücünü kontrol eder. Daha "
"yüksek lambda her katsayıyı sıfıra doğru daha da daraltır ancak hiçbiri "
"sıfıra ulaşmaz, bu nedenle değişken sayısı asla değişmez.</li>"

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Multiply odds by likelihood ratio</strong>: Post-test odds = "
"Pre-test odds \\u{00D7} LR</li>"
msgstr ""
"<li><strong>Odds'u olabilirlik oranıyla çarpın</strong>: Test sonrası odds = "
"Test öncesi odds \\u{00D7} LR</li>"

#: R/sequentialtests.b.R
msgid "<li><strong>Negative Likelihood Ratio (LR-)</strong>: (1-Se)/Sp</li>"
msgstr "<li><strong>Negatif Olabilirlik Oranı (LR-)</strong>: (1-Se)/Sp</li>"

#: R/lassologistic.b.R
msgid ""
"<li><strong>Odds Ratio</strong>: exp(coefficient). OR > 1 increases "
"probability of the positive class.</li>"
msgstr ""
"<li><strong>Odds Oranı</strong>: exp(katsayı). OR > 1 pozitif sınıf "
"olasılığını artırır.</li>"

#: R/sequentialtests.b.R
msgid "<li><strong>Positive Likelihood Ratio (LR+)</strong>: Se/(1-Sp)</li>"
msgstr "<li><strong>Pozitif Olabilirlik Oranı (LR+)</strong>: Se/(1-Sp)</li>"

#: R/sequentialtests.b.R
msgid "<li><strong>Prevalence (P)</strong>: The pre-test probability of disease</li>"
msgstr "<li><strong>Prevalans (P)</strong>: Hastalığın test öncesi olasılığı</li>"

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Sensitivity (Se)</strong>: Probability of a positive test in "
"diseased subjects</li>"
msgstr ""
"<li><strong>Duyarlılık (Se)</strong>: Hastalıklı deneklerde testin pozitif "
"çıkma olasılığı</li>"

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Specificity (Sp)</strong>: Probability of a negative test in "
"non-diseased subjects</li>"
msgstr ""
"<li><strong>Özgüllük (Sp)</strong>: Hastalıksız deneklerde testin negatif "
"çıkma olasılığı</li>"

#: R/lassologistic.b.R
msgid ""
"<li><strong>Standardization (default on):</strong> predictors are centered "
"and scaled before fitting, so the penalty treats variables with different "
"units comparably. The Coefficient and Odds Ratio columns of the Selected "
"Variables table are then back-transformed to the <strong>original "
"measurement scale</strong> (per 1 unit of a continuous predictor, or present "
"vs absent for a binary one). The Importance column and the Coefficient Plot "
"stay on the per-standard-deviation scale, which is the quantity that is "
"comparable across predictors with different units.</li>"
msgstr ""
"<li><strong>Standardizasyon (varsayılan açık):</strong> tahmin ediciler "
"uyarlamadan önce merkezileştirilir ve ölçeklendirilir, böylece ceza farklı "
"birimlere sahip değişkenleri karşılaştırılabilir şekilde ele alır. Seçilen "
"Değişkenler tablosunun Katsayı ve Odds Oranı sütunları daha sonra "
"<strong>orijinal ölçüm ölçeğine</strong> geri dönüştürülür (sürekli bir "
"tahmin edicinin 1 birimi başına veya ikili bir tahmin edici için var ve "
"yok). Önem sütunu ve Katsayı Grafiği, farklı birimlere sahip tahmin ediciler "
"arasında karşılaştırılabilir olan standart sapma başına ölçekte kalır.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Always validate the scoring system on an independent cohort before "
"clinical adoption.</li>"
msgstr ""
"<li>Klinik benimsemeden önce puanlama sistemini her zaman bağımsız bir "
"kohortta doğrulayın.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Bootstrap optimism correction estimates how much the apparent AUC "
"overestimates true performance.</li>"
msgstr ""
"<li>Bootstrap iyimserlik düzeltmesi, görünürdeki EAA'nın gerçek performansı "
"ne kadar abarttığını tahmin eder.</li>"

#: R/sequentialtests.b.R
msgid "<li>Combined probability = {first} + {second} = {combined}</li>"
msgstr "<li>Birleşik olasılık = {first} + {second} = {combined}</li>"

#: R/sequentialtests.b.R
msgid "<li>Combined probability = {sens1} \\u{00D7} {sens2} = {combined}</li>"
msgstr "<li>Birleşik olasılık = {sens1} \\u{00D7} {sens2} = {combined}</li>"

#: R/sequentialtests.b.R
msgid "<li>Combined probability = {sens1} + {sens2} - {both} = {combined}</li>"
msgstr "<li>Birleşik olasılık = {sens1} + {sens2} - {both} = {combined}</li>"

#: R/sequentialtests.b.R
msgid "<li>Combined probability = {spec1} \\u{00D7} {spec2} = {combined}</li>"
msgstr "<li>Birleşik olasılık = {spec1} \\u{00D7} {spec2} = {combined}</li>"

#: R/sequentialtests.b.R
msgid "<li>Combined sensitivity (Se) = {value}</li>"
msgstr "<li>Birleşik duyarlılık (Se) = {value}</li>"

#: R/sequentialtests.b.R
msgid "<li>Combined specificity (Sp) = {value}</li>"
msgstr "<li>Birleşik özgüllük (Sp) = {value}</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Continuous predictors in the scoring system are dichotomized at %s (set "
"by 'Cut Point for Continuous Predictors'); the score-based performance "
"therefore reflects a simplified point model and may differ from the "
"continuous LASSO model's AUC.</li>"
msgstr ""
"<li>Puanlama sistemindeki sürekli tahmin ediciler %s noktasında ikiye "
"ayrılır ('Sürekli Tahmin Ediciler İçin Kesim Noktası' ile ayarlanır); bu "
"nedenle puana dayalı performans basitleştirilmiş bir puan modelini yansıtır "
"ve sürekli LASSO modelinin EAA değerinden farklı olabilir.</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Denominator = (1-P) \\u{00D7} Sp + P \\u{00D7} (1-Se) = {numerator} + "
"{p} \\u{00D7} {oneMinusSe} = {denominator}</li>"
msgstr ""
"<li>Payda = (1-P) \\u{00D7} Sp + P \\u{00D7} (1-Se) = {numerator} + {p} "
"\\u{00D7} {oneMinusSe} = {denominator}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Denominator = P \\u{00D7} Se + (1-P) \\u{00D7} (1-Sp) = {numerator} + "
"{oneMinusP} \\u{00D7} {oneMinusSp} = {denominator}</li>"
msgstr ""
"<li>Payda = P \\u{00D7} Se + (1-P) \\u{00D7} (1-Sp) = {numerator} + "
"{oneMinusP} \\u{00D7} {oneMinusSp} = {denominator}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Emergency teaching pair (Physiologic test + "
"Biomarker)</li><li>Acute-imaging teaching pair (Clinical assessment + "
"Imaging)</li>"
msgstr ""
"<li>Acil eğitim çifti (Fizyolojik test + Biyobelirteç)</li><li>Akut "
"görüntüleme eğitim çifti (Klinik değerlendirme + Görüntüleme)</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Events-per-variable (EPV) should be >=10. Below 5, results are "
"unreliable regardless of regularization.</li>"
msgstr ""
"<li>Değişken başına olay (EPV) >=10 olmalıdır. 5'in altında, "
"düzenlileştirmeden bağımsız olarak sonuçlar güvenilmezdir.</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Given a negative Test 1, probability of testing negative on Test 2: "
"{value}</li>"
msgstr ""
"<li>Negatif Test 1 verildiğinde, Test 2'de negatif test etme olasılığı: "
"{value}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Given a positive Test 1, probability of testing positive on Test 2: "
"{value}</li>"
msgstr ""
"<li>Pozitif Test 1 verildiğinde, Test 2'de pozitif test etme olasılığı: "
"{value}</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Higher total scores indicate higher probability of the event (positive "
"class).</li>"
msgstr ""
"<li>Daha yüksek toplam puanlar olayın (pozitif sınıf) daha yüksek "
"olasılığını gösterir.</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>HIV-style teaching pair (Ag/Ab assay \\u{2192} differentiation assay); "
"this is not a complete HIV diagnostic algorithm</li><li>Cancer-screening "
"teaching pair (Imaging \\u{2192} Tissue "
"sampling)</li><li>Respiratory-infection teaching pair (Rapid antigen "
"\\u{2192} Molecular assay)</li>"
msgstr ""
"<li>HIV tarzı eğitim çifti (Ag/Ab testi \\u{2192} farklılaştırma testi); bu "
"eksiksiz bir HIV tanısal algoritması değildir</li><li>Kanser taraması eğitim "
"çifti (Görüntüleme \\u{2192} Doku örneklemesi)</li><li>Solunum yolu "
"enfeksiyonu eğitim çifti (Hızlı antijen \\u{2192} Moleküler test)</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Inter-observer agreement should be assessed for any morphologic scoring "
"components.</li>"
msgstr ""
"<li>Herhangi bir morfolojik puanlama bileşeni için gözlemciler arası uyum "
"değerlendirilmelidir.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>LASSO coefficients do not have standard errors or p-values. Use "
"bootstrap validation for inference.</li>"
msgstr ""
"<li>LASSO katsayılarının standart hataları veya p değerleri yoktur. Çıkarım "
"için bootstrap doğrulamasını kullanın.</li>"

#: R/sequentialtests.b.R
msgid "<li>NPV = numerator/denominator = {numerator}/{denominator} = {npv}</li>"
msgstr "<li>NÖD = pay/payda = {numerator}/{denominator} = {npv}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Numerator = (1-P) \\u{00D7} Sp = {oneMinusP} \\u{00D7} {sp} = "
"{numerator}</li>"
msgstr "<li>Pay = (1-P) \\u{00D7} Sp = {oneMinusP} \\u{00D7} {sp} = {numerator}</li>"

#: R/sequentialtests.b.R
msgid "<li>Numerator = P \\u{00D7} Se = {p} \\u{00D7} {se} = {numerator}</li>"
msgstr "<li>Pay = P \\u{00D7} Se = {p} \\u{00D7} {se} = {numerator}</li>"

#: R/sequentialtests.b.R
msgid "<li>PPV = numerator/denominator = {numerator}/{denominator} = {ppv}</li>"
msgstr "<li>PÖD = pay/payda = {numerator}/{denominator} = {ppv}</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Predictors were <strong>not</strong> standardized; coefficients, odds "
"ratios, importance, and the Coefficient Plot are all on the original "
"measurement scale of each variable.</li>"
msgstr ""
"<li>Tahmin ediciler standardize <strong>edilmemiştir</strong>; katsayılar, "
"odds oranları, önem ve Katsayı Grafiği her değişkenin orijinal ölçüm "
"ölçeğindedir.</li>"

#: R/sequentialtests.b.R
msgid "<li>Prevalence (P) = {value}</li>"
msgstr "<li>Prevalans (P) = {value}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Probability of negative Test 1 followed by positive Test 2: (1 - "
"{sens1}) \\u{00D7} {sens2} = {value}</li>"
msgstr ""
"<li>Negatif Test 1 ardından pozitif Test 2 olasılığı: (1 - {sens1}) "
"\\u{00D7} {sens2} = {value}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Probability of positive Test 1 followed by negative Test 2: (1 - "
"{spec1}) \\u{00D7} {spec2} = {value}</li>"
msgstr ""
"<li>Pozitif Test 1 ardından negatif Test 2 olasılığı: (1 - {spec1}) "
"\\u{00D7} {spec2} = {value}</li>"

#: R/sequentialtests.b.R
msgid "<li>Probability of testing negative on Test 1: {value}</li>"
msgstr "<li>Test 1'de negatif test etme olasılığı: {value}</li>"

#: R/sequentialtests.b.R
msgid "<li>Probability of testing negative on Test 2: {value}</li>"
msgstr "<li>Test 2'de negatif test etme olasılığı: {value}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Probability of testing positive on both: {sens1} \\u{00D7} {sens2} = "
"{both}</li>"
msgstr ""
"<li>Her ikisinde de pozitif çıkma olasılığı: {sens1} \\u{00D7} {sens2} = "
"{both}</li>"

#: R/sequentialtests.b.R
msgid "<li>Probability of testing positive on Test 1: {value}</li>"
msgstr "<li>Test 1'de pozitif çıkma olasılığı: {value}</li>"

#: R/sequentialtests.b.R
msgid "<li>Probability of testing positive on Test 2: {value}</li>"
msgstr "<li>Test 2'de pozitif çıkma olasılığı: {value}</li>"

#: R/sequentialtests.b.R
msgid ""
"<li>Rule-out teaching pair (Initial assessment \\u{2192} "
"Biomarker)</li><li>Exclusion teaching pair (Clinical score \\u{2192} "
"Laboratory assay)</li>"
msgstr ""
"<li>Dışlama eğitim çifti (İlk değerlendirme \\u{2192} "
"Biyobelirteç)</li><li>Dışlama eğitim çifti (Klinik skor \\u{2192} "
"Laboratuvar testi)</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Selected variables are the features most useful for distinguishing the "
"two groups.</li>"
msgstr ""
"<li>Seçilen değişkenler iki grubu ayırt etmek için en yararlı "
"özelliklerdir.</li>"

#: R/sequentialtests.b.R
msgid "<li>Test negative on Test 1 but positive on Test 2</li>"
msgstr "<li>Test 1'de negatif ancak Test 2'de pozitif test</li>"

#: R/sequentialtests.b.R
msgid "<li>Test negative on Test 1, OR</li>"
msgstr "<li>Test 1'de negatif test, VEYA</li>"

#: R/sequentialtests.b.R
msgid "<li>Test positive on Test 1 but negative on Test 2</li>"
msgstr "<li>Test 1'de pozitif ancak Test 2'de negatif test</li>"

#: R/sequentialtests.b.R
msgid "<li>Test positive on Test 1, OR</li>"
msgstr "<li>Test 1'de pozitif test, VEYA</li>"

#: R/lassologistic.b.R
msgid ""
"<li>The scoring system assigns positive points for features favoring the "
"event class and negative points for the reference class.</li>"
msgstr ""
"<li>Puanlama sistemi olay sınıfını destekleyen özellikler için pozitif "
"puanlar, referans sınıf için negatif puanlar verir.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>The scoring system rounds coefficients to integers, which loses "
"precision but gains clinical usability.</li>"
msgstr ""
"<li>Puanlama sistemi katsayıları tam sayılara yuvarlar, bu da kesinliği "
"kaybeder ancak klinik kullanılabilirlik kazandırır.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>Variables NOT selected are not necessarily unimportant - they may be "
"redundant with selected features.</li>"
msgstr ""
"<li>Seçilmeyen değişkenler mutlaka önemsiz değildir - seçilen özelliklerle "
"gereksiz (yedekli) olabilirler.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>With correlated predictors, LASSO arbitrarily selects one from a group. "
"Consider elastic net (alpha 0.5).</li>"
msgstr ""
"<li>Korelasyonlu tahmin edicilerle LASSO bir gruptan rastgele birini seçer. "
"Elastic net (alfa 0.5) düşünün.</li>"

#: R/lassologistic.b.R
msgid ""
"<li>With correlated predictors, Ridge shares the coefficient among them "
"rather than picking one, which is one reason to prefer it when predictors "
"are collinear.</li>"
msgstr ""
"<li>Korelasyonlu tahmin edicilerle Ridge, birini seçmek yerine katsayıyı "
"aralarında paylaşır; bu da tahmin ediciler eşdoğrusal (collinear) olduğunda "
"bunu tercih etmenin bir nedenidir.</li>"

#: R/sequentialtests.b.R
msgid "<ol>"
msgstr "<ol>"

#: R/sequentialtests.b.R
msgid "<p>Calculation steps:</p>"
msgstr "<p>Hesaplama adımları:</p>"

#: R/psychopdaROC.b.R
msgid ""
"<p>Dot plots aren't available in combined plot mode. Please uncheck 'Combine "
"plots' to view individual dot plots.</p>"
msgstr ""
"<p>Nokta grafikleri birleştirilmiş grafik modunda kullanılamaz. Bireysel "
"nokta grafiklerini görüntülemek için lütfen 'Grafikleri birleştir' işaretini "
"kaldırın.</p>"

#: R/lassologistic.b.R
msgid ""
"<p>Elastic Net blends the L1 (LASSO) and L2 (Ridge) penalties, here with a "
"mixing weight of alpha = %.2f. The L1 part can shrink coefficients exactly "
"to zero, so some variable selection still happens, while the L2 part keeps "
"correlated predictors together instead of letting the model pick one of them "
"arbitrarily.</p>"
msgstr ""
"<p>Elastic Net, burada alfa = %.2f karışım ağırlığı ile L1 (LASSO) ve L2 "
"(Ridge) cezalarını harmanlar. L1 kısmı katsayıları tam olarak sıfıra "
"daraltabilir, böylece bir miktar değişken seçimi devam eder; L2 kısmı ise "
"modelin bunlardan birini rastgele seçmesine izin vermek yerine korelasyonlu "
"tahmin edicileri bir arada tutar.</p>"

#: R/sequentialtests.b.R
msgid "<p>For a subject to test negative in this strategy, they must either:</p>"
msgstr ""
"<p>Bir deneğin bu stratejide negatif test sonucu vermesi için şunlardan biri "
"olmalıdır:</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>For a subject to test negative in this strategy, they must test negative "
"on both tests:</p>"
msgstr ""
"<p>Bir deneğin bu stratejide negatif test sonucu vermesi için her iki testte "
"de negatif çıkması gerekir:</p>"

#: R/sequentialtests.b.R
msgid "<p>For a subject to test positive in this strategy, they must either:</p>"
msgstr ""
"<p>Bir deneğin bu stratejide pozitif test sonucu vermesi için şunlardan biri "
"olmalıdır:</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>For a subject to test positive in this strategy, they must test positive "
"on at least one test. This is calculated using the complement of the "
"probability of testing negative on both tests:</p>"
msgstr ""
"<p>Bir deneğin bu stratejide pozitif test sonucu vermesi için en az bir "
"testte pozitif çıkması gerekir. Bu, her iki testte de negatif çıkma "
"olasılığının tümleyeni kullanılarak hesaplanır:</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>For a subject to test positive in this strategy, they must test positive "
"on both tests:</p>"
msgstr ""
"<p>Bir deneğin bu stratejide pozitif test sonucu vermesi için her iki testte "
"de pozitif çıkması gerekir:</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>How much more likely a negative test result is to occur in patients with "
"disease compared to those without:</p>"
msgstr ""
"<p>Negatif bir test sonucunun hastalığı olanlarda olmayanlara kıyasla ortaya "
"çıkma olasılığının ne kadar daha fazla olduğu:</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>How much more likely a positive test result is to occur in patients with "
"disease compared to those without:</p>"
msgstr ""
"<p>Pozitif bir test sonucunun hastalığı olanlarda olmayanlara kıyasla ortaya "
"çıkma olasılığının ne kadar daha fazla olduğu:</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>In this strategy, both tests are performed on all subjects. A subject is "
"considered positive if either test is positive.</p>"
msgstr ""
"<p>Bu stratejide her iki test de tüm deneklere uygulanır. Herhangi bir test "
"pozitifse denek pozitif kabul edilir.</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>In this strategy, the second test is only performed if the first test is "
"negative. A subject is considered positive if either test is positive.</p>"
msgstr ""
"<p>Bu stratejide ikinci test yalnızca ilk test negatifse uygulanır. Herhangi "
"bir test pozitifse denek pozitif kabul edilir.</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>In this strategy, the second test is only performed if the first test is "
"positive. A subject is considered positive only if both tests are "
"positive.</p>"
msgstr ""
"<p>Bu stratejide ikinci test yalnızca ilk test pozitifse uygulanır. Bir "
"denek yalnızca her iki test de pozitifse pozitif kabul edilir.</p>"

#: R/lassologistic.b.R
msgid ""
"<p>LASSO (Least Absolute Shrinkage and Selection Operator) adds an L1 "
"penalty to the logistic regression likelihood, which shrinks some "
"coefficients exactly to zero. This performs automatic variable selection, "
"identifying the most important predictors for your binary outcome.</p>"
msgstr ""
"<p>LASSO (En Küçük Mutlak Daralma ve Seçim Operatörü), lojistik regresyon "
"olabilirliğine bazı katsayıları tam olarak sıfıra daraltan bir L1 cezası "
"ekler. Bu, otomatik değişken seçimi gerçekleştirerek ikili sonucunuz için en "
"önemli tahmin edicileri tanımlar.</p>"

#: R/sequentialtests.b.R
msgid "<p>LR- = (1 - {se}) / {sp} = {lr}</p>"
msgstr "<p>LR- = (1 - {se}) / {sp} = {lr}</p>"

#: R/sequentialtests.b.R
msgid "<p>LR- = (1 - Sensitivity) / Specificity</p>"
msgstr "<p>LR- = (1 - Duyarlılık) / Özgüllük</p>"

#: R/sequentialtests.b.R
msgid "<p>LR+ = {se} / (1 - {sp}) = {lr}</p>"
msgstr "<p>LR+ = {se} / (1 - {sp}) = {lr}</p>"

#: R/sequentialtests.b.R
msgid "<p>LR+ = Sensitivity / (1 - Specificity)</p>"
msgstr "<p>LR+ = Duyarlılık / (1 - Özgüllük)</p>"

#: R/sequentialtests.b.R
msgid "<p>NPV = ((1-P) \\u{00D7} Sp) / ((1-P) \\u{00D7} Sp + P \\u{00D7} (1-Se))</p>"
msgstr "<p>NÖD = ((1-P) \\u{00D7} Sp) / ((1-P) \\u{00D7} Sp + P \\u{00D7} (1-Se))</p>"

#: R/sequentialtests.b.R
msgid "<p>PPV = (P \\u{00D7} Se) / (P \\u{00D7} Se + (1-P) \\u{00D7} (1-Sp))</p>"
msgstr "<p>PÖD = (P \\u{00D7} Se) / (P \\u{00D7} Se + (1-P) \\u{00D7} (1-Sp))</p>"

#: R/sequentialtests.b.R
msgid "<p>Probability calculation:</p>"
msgstr "<p>Olasılık hesaplaması:</p>"

#: R/lassologistic.b.R
msgid ""
"<p>Ridge regression adds an L2 penalty to the logistic regression "
"likelihood. It shrinks coefficients toward zero but never "
"<strong>to</strong> zero, so it does <strong>not</strong> perform variable "
"selection: every predictor you supplied is retained in the model. Ridge is "
"the right choice when you believe most predictors carry some signal, or when "
"they are strongly correlated and you want the penalty shared among them "
"rather than one arbitrarily kept.</p>"
msgstr ""
"<p>Ridge regresyonu lojistik regresyon olabilirliğine bir L2 cezası ekler. "
"Katsayıları sıfıra doğru daraltır ancak asla sıfıra <strong>kadar</strong> "
"daraltmaz, bu nedenle değişken seçimi <strong>yapmaz</strong>: sağladığınız "
"her tahmin edici modelde tutulur. Çoğu tahmin edicinin bir miktar sinyal "
"taşıdığına inandığınızda veya güçlü bir şekilde korelasyonlu olduklarında ve "
"cezanın birinin rastgele tutulması yerine aralarında paylaşılmasını "
"istediğinizde Ridge doğru seçimdir.</p>"

#: R/sequentialtests.b.R
msgid ""
"<p>Se<sub>combined</sub> = 1 - (1-Se<sub>1</sub>) \\u{00D7} "
"(1-Se<sub>2</sub>)</p>"
msgstr ""
"<p>Se<sub>birleşik</sub> = 1 - (1-Se<sub>1</sub>) \\u{00D7} "
"(1-Se<sub>2</sub>)</p>"

