#: R/decisioncompare.b.R
msgid ""
"<li><b>Adequate Information:</b> Precision and power depend strongly on the "
"number of discordant pairs</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><b>Available Cases:</b> Standalone metrics use each test's observed "
"reference/test pairs; paired comparisons use common determinate rows</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><b>Binary Recoding:</b> Each test is analyzed after positive/negative "
"recoding; multilevel results require explicit handling when indeterminate "
"values should be excluded</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><b>Gold Standard:</b> Reference test must represent true disease status "
"(e.g., biopsy, final diagnosis)</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><b>Paired Data:</b> All tests must be performed on the same "
"patients/samples (not independent groups)</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>1SE Rule</strong>: Selects the most parsimonious model within 1 "
"SE of minimum CV error.</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Choose Tests to Compare:</strong> Select 2-3 diagnostic tests "
"you want to evaluate</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Clinical Research:</strong> Validating biomarkers, imaging "
"techniques, or clinical assessments</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Confidence Intervals:</strong> The per-test CI tables report "
"Clopper-Pearson exact intervals for the proportions (sensitivity, "
"specificity, PPV, NPV, accuracy and prevalence), as computed by "
"epiR::epi.tests() with its default settings. Likelihood ratios are reported "
"as point estimates only, without confidence intervals. The Overall Percent "
"Agreement (OPA) table uses the selected single-proportion method. Paired "
"differences use Newcombe's method-10 score interval for correlated "
"proportions.</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Configure Options:</strong> Enable statistical comparisons, "
"confidence intervals, or visualizations as needed</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Convert post-test odds back to probability</strong>: Post-test P "
"= Odds/(1+Odds)</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Convert pre-test probability to odds</strong>: Odds = "
"P/(1-P)</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Copy Report:</strong> Use the auto-generated sentences for your "
"documentation</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Define Positive Levels:</strong> Specify what constitutes a "
"\"positive\" result for each test</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Elastic Net</strong>: Combines L1 and L2 penalties; useful when "
"predictors are correlated.</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Gold Standard:</strong> Assumes your reference test is truly "
"accurate</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Lambda</strong>: Controls regularization strength. Higher lambda "
"= fewer variables selected.</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Lambda</strong>: Controls regularization strength. Higher lambda "
"shrinks every coefficient further toward zero, but none reaches zero, so the "
"number of variables never changes.</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>McNemar Test:</strong> Requires paired/matched data for "
"statistical comparisons</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Method Comparison:</strong> Describing and testing differences "
"among paired tests</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Missing Data:</strong> Standalone estimates use available "
"reference/test pairs; paired comparisons use common determinate rows. "
"Missing-data handling and counts should be reported.</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Multiply odds by likelihood ratio</strong>: Post-test odds = "
"Pre-test odds × LR</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li><strong>Negative Likelihood Ratio (LR-)</strong>: (1-Se)/Sp</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Odds Ratio</strong>: exp(coefficient). OR > 1 increases "
"probability of the positive class.</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li><strong>Positive Likelihood Ratio (LR+)</strong>: Se/(1-Sp)</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid "<li><strong>Prevalence (P)</strong>: The pre-test probability of disease</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Prevalence Dependency:</strong> PPV and NPV vary with disease "
"prevalence</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Protocol Development:</strong> Optimizing diagnostic "
"workflows</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Quality Assessment:</strong> Measuring agreement between "
"different raters or methods</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Run Analysis:</strong> Review estimates, denominators, "
"exclusions, and statistical comparisons</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Sample Size:</strong> Results more reliable with larger, "
"representative samples</li>"
msgstr ""

#: R/decisioncompare.b.R
msgid ""
"<li><strong>Select Gold Standard:</strong> Choose your most reliable "
"reference test (e.g., biopsy, expert consensus)</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Sensitivity (Se)</strong>: Probability of a positive test in "
"diseased subjects</li>"
msgstr ""

#: R/sequentialtests.b.R
msgid ""
"<li><strong>Specificity (Sp)</strong>: Probability of a negative test in "
"non-diseased subjects</li>"
msgstr ""

#: R/lassologistic.b.R
msgid ""
"<li><strong>Standardization (default on):</strong> predictors are centered "
"and scaled before fitting, so the penalty treats variables with different "
"units comparably. The Coefficient and Odds Ratio columns of the Selected "
"Variables table are then back-transformed to the <strong>original "
"measurement scale</strong> (per 1 unit of a continuous predictor, or present "
"vs absent for a binary one). The Importance column and the Coefficient Plot "
"stay on the per-standard-deviation scale, which is the quantity that is "
